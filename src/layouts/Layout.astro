---
import "../styles/global.css";
import GlobalLangSwitcher from "../components/GlobalLangSwitcher";

interface Props {
  title?: string;
}

const { title = "登录" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="用户登录" />
    <title>{title}</title>

  </head>

  <body>
    <GlobalLangSwitcher client:load />
    <main>
      <slot />
    </main>

    {/* DEBUG: island boot with on-page logging */}
    <script is:inline>
      (async function () {
        var out = document.createElement("pre");
        out.style.cssText = "position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#000;color:#0f0;font-size:10px;padding:6px;max-height:60vh;overflow:auto;white-space:pre-wrap;margin:0;font-family:monospace;line-height:1.3";
        out.textContent = "[boot] starting\n";
        document.body.appendChild(out);

        function log(msg) {
          out.textContent += msg + "\n";
          try { console.log("[boot]", msg); } catch (e) {}
        }

        try {
          log("customElement astro-island defined: " + !!customElements.get("astro-island"));

          var islands = document.querySelectorAll("astro-island[client]");
          log("islands found: " + islands.length);

          for (var i = 0; i < islands.length; i++) {
            var el = islands[i];
            log("--- island " + i + " ---");
            log("  client: " + el.getAttribute("client") + "  ssr: " + el.hasAttribute("ssr"));
            log("  hydrate fn: " + (typeof el.hydrate));
            log("  hydrator: " + (typeof el.hydrator));

            var rendererUrl = el.getAttribute("renderer-url");
            var componentUrl = el.getAttribute("component-url");
            var componentExport = el.getAttribute("component-export") || "default";

            try {
              log("  importing renderer: " + rendererUrl);
              var rendererMod = await import(rendererUrl);
              log("  renderer keys: " + Object.keys(rendererMod).join(","));
              log("  renderer default type: " + typeof rendererMod.default);

              log("  importing component: " + componentUrl);
              var componentMod = await import(componentUrl);
              log("  component keys: " + Object.keys(componentMod).join(","));
              log("  component[" + componentExport + "] type: " + typeof componentMod[componentExport]);

              el.hydrator = rendererMod.default;
              el.Component = componentMod[componentExport];

              log("  calling hydrate()...");
              await el.hydrate();
              log("  hydrate OK");
            } catch (err) {
              log("  ERROR: " + (err && err.message ? err.message : String(err)));
              log("  STACK: " + (err && err.stack ? err.stack.split("\n").slice(0, 4).join(" || ") : "n/a"));
            }
          }

          log("done");
        } catch (err) {
          log("FATAL: " + (err && err.message ? err.message : String(err)));
        }
      })();
    </script>
    </body>
</html>
