---
import "../styles/global.css";
import GlobalLangSwitcher from "../components/GlobalLangSwitcher";

interface Props {
  title?: string;
}

const { title = "登录" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="用户登录" />
    <title>{title}</title>

  </head>

  <body>
    <GlobalLangSwitcher client:load />
    <main>
      <slot />
    </main>

    {/* DEBUG v2: capture console + check React control */}
    <script is:inline>
      (async function () {
        var out = document.createElement("pre");
        out.style.cssText = "position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#000;color:#0f0;font-size:10px;padding:4px;max-height:35vh;overflow:auto;white-space:pre-wrap;margin:0;font-family:monospace;line-height:1.2";
        out.textContent = "[boot v2]\n";
        document.body.appendChild(out);

        function log(msg) {
          out.textContent += msg + "\n";
          out.scrollTop = out.scrollHeight;
        }

        // 拦截 console
        var _warn = console.warn, _error = console.error;
        console.warn = function () {
          var m = Array.prototype.slice.call(arguments).map(function (a) {
            try { return typeof a === "string" ? a : JSON.stringify(a); } catch (e) { return String(a); }
          }).join(" ");
          log("WARN: " + m.slice(0, 400));
          _warn.apply(console, arguments);
        };
        console.error = function () {
          var m = Array.prototype.slice.call(arguments).map(function (a) {
            try { return typeof a === "string" ? a : JSON.stringify(a); } catch (e) { return String(a); }
          }).join(" ");
          log("ERR: " + m.slice(0, 600));
          _error.apply(console, arguments);
        };

        window.addEventListener("error", function (e) {
          log("window.error: " + (e.message || "") + " @ " + (e.filename || "") + ":" + (e.lineno || ""));
        });

        window.addEventListener("unhandledrejection", function (e) {
          var r = e.reason;
          log("rejection: " + (r && r.message ? r.message : String(r)));
        });

        try {
          var islands = document.querySelectorAll("astro-island[client]");
          log("islands: " + islands.length);

          for (var i = 0; i < islands.length; i++) {
            var el = islands[i];
            var componentUrl = el.getAttribute("component-url");
            var rendererUrl = el.getAttribute("renderer-url");
            var componentExport = el.getAttribute("component-export") || "default";

            try {
              var rm = await import(rendererUrl);
              var cm = await import(componentUrl);
              el.hydrator = rm.default;
              el.Component = cm[componentExport];
              await el.hydrate();
              log("hydrate " + i + " OK  " + componentUrl.split("/").pop());
            } catch (err) {
              log("hydrate " + i + " ERR: " + (err && err.message ? err.message : String(err)));
            }
          }

          // 等 React 接管
          await new Promise(function (r) { setTimeout(r, 500); });

          // 检查 React 是否接管了 DOM
          function reactKeys(node) {
            if (!node) return [];
            return Object.keys(node).filter(function (k) {
              return k.indexOf("__react") === 0;
            });
          }

          var form = document.querySelector("form");
          var firstInput = document.querySelector("input");
          var signinBtn = document.querySelector('button[type="submit"]');
          var langBtn = document.querySelector('button[aria-label="Change language"]');

          log("--- React DOM control check ---");
          log("form found: " + !!form);
          log("form react keys: [" + reactKeys(form).join(",") + "]");
          log("input react keys: [" + reactKeys(firstInput).join(",") + "]");
          log("signin btn found: " + !!signinBtn);
          log("signin btn react keys: [" + reactKeys(signinBtn).join(",") + "]");
          log("lang btn found: " + !!langBtn);
          log("lang btn react keys: [" + reactKeys(langBtn).join(",") + "]");

          // 检查 Cap widget 是否创建
          var capWidget = document.querySelector("cap-widget");
          log("cap-widget element: " + (capWidget ? "EXISTS" : "MISSING"));
          log("cap-script tag: " + (document.querySelector('script[data-cap-script="true"]') ? "LOADED" : "NOT LOADED"));

          log("done v2");
        } catch (err) {
          log("FATAL: " + (err && err.message ? err.message : String(err)));
        }
      })();
    </script>
    </body>
</html>
