---
import "../styles/global.css";
import GlobalLangSwitcher from "../components/GlobalLangSwitcher";

interface Props {
  title?: string;
}

const { title = "登录" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="用户登录" />
    <title>{title}</title>

  </head>

  <body>
    <GlobalLangSwitcher client:load />
    <main>
      <slot />
    </main>

    {/* DEBUG v3: banner click test + cap check */}
    <script is:inline>
      (function () {
        // 红色大横幅：点击测试
        var banner = document.createElement("div");
        banner.style.cssText = "position:fixed;top:0;left:0;right:0;z-index:2147483647;background:#c00;color:#fff;padding:14px;font-size:17px;text-align:center;cursor:pointer;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,0.3)";
        banner.textContent = "🔴 点我测试事件系统";
        banner.onclick = function () {
          banner.textContent = "✅ 事件正常 · " + new Date().toLocaleTimeString();
          banner.style.background = "#080";
        };
        document.body.appendChild(banner);

        // 底部日志
        var out = document.createElement("div");
        out.style.cssText = "position:fixed;left:0;right:0;bottom:0;z-index:2147483646;background:#000;color:#0f0;font-size:10px;padding:4px;max-height:28vh;overflow-y:auto;white-space:pre-wrap;font-family:monospace;line-height:1.2";
        document.body.appendChild(out);

        function log(m) {
          out.appendChild(document.createTextNode(m + "\n"));
          out.scrollTop = out.scrollHeight;
        }

        // 捕获 console
        var _err = console.error;
        console.error = function () {
          var a = Array.prototype.slice.call(arguments).map(function (x) {
            try { return typeof x === "string" ? x : JSON.stringify(x); } catch (e) { return String(x); }
          }).join(" ");
          log("ERR: " + a.slice(0, 500));
          _err.apply(console, arguments);
        };

        window.addEventListener("error", function (e) {
          log("window.error: " + (e.message || "") + " @ " + (e.lineno || ""));
        });

        window.addEventListener("unhandledrejection", function (e) {
          var r = e.reason;
          log("rej: " + (r && r.message ? r.message : String(r)));
        });

        // 立刻做一遍检查，不延迟
        function check(label) {
          try {
            log("--- " + label + " ---");
            var form = document.querySelector("form");
            var fk = form ? Object.keys(form).filter(function (k) { return k.indexOf("__react") === 0; }) : [];
            log("form: " + (form ? "有" : "无") + " reactKeys: [" + fk.join(",") + "]");

            var input = document.querySelector("input");
            var ik = input ? Object.keys(input).filter(function (k) { return k.indexOf("__react") === 0; }) : [];
            log("input reactKeys: [" + ik.join(",") + "]");

            var capW = document.querySelector("cap-widget");
            log("cap-widget: " + (capW ? "存在" : "不存在"));

            var capS = document.querySelector('script[data-cap-script="true"]');
            log("cap-script tag: " + (capS ? "已插入" : "未插入") + (capS ? " src=" + capS.src : ""));

            log("cap customElement: " + (customElements.get("cap-widget") ? "已注册" : "未注册"));

            var islands = document.querySelectorAll("astro-island[client]");
            log("islands[client]: " + islands.length);
            for (var i = 0; i < islands.length; i++) {
              var el = islands[i];
              var cu = el.getAttribute("component-url");
              log("  " + i + ": " + (cu ? cu.split("/").pop() : "?") + " ssr=" + el.hasAttribute("ssr") + " hydrator=" + (typeof el.hydrator));
            }
          } catch (e) {
            log("check err: " + (e && e.message ? e.message : String(e)));
          }
        }

        // 现在检查一次
        check("t0 立即");

        // 500ms 后再检查一次（此时 React useEffect 应该跑过了）
        setTimeout(function () { check("t1 500ms"); }, 500);

        // 1500ms 再检查一次（Cap script 应该加载完了）
        setTimeout(function () { check("t2 1500ms"); }, 1500);

      })();
    </script>
    </body>
</html>
