---
import "../styles/global.css";
import GlobalLangSwitcher from "../components/GlobalLangSwitcher";

interface Props {
  title?: string;
}

const { title = "登录" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="用户登录" />
    <title>{title}</title>
  </head>

  <body>
    <GlobalLangSwitcher client:load />
    <main>
      <slot />
    </main>

    {/* Astro 7 未自动注入 island boot 脚本，手动触发 hydration */}
    <script is:inline>
      (function () {
        function boot(el) {
          if (el.__booted) return;
          if (!el.hasAttribute("client")) return;
          if (!el.hasAttribute("ssr")) return;
          el.__booted = true;

          var rendererUrl = el.getAttribute("renderer-url");
          var componentUrl = el.getAttribute("component-url");
          var componentExport = el.getAttribute("component-export") || "default";
          if (!rendererUrl || !componentUrl) return;

          Promise.all([import(rendererUrl), import(componentUrl)])
            .then(function (mods) {
              var hydrator = mods[0].default;
              var Component = mods[1][componentExport];
              if (typeof hydrator !== "function" || !Component) return;
              el.Component = Component;
              el.hydrator = hydrator;
              return el.hydrate();
            })
            .catch(function (err) {
              console.error("[island] boot failed", componentUrl, err);
            });
        }

        function bootAll() {
          document.querySelectorAll("astro-island[client][ssr]").forEach(boot);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bootAll, { once: true });
        } else {
          bootAll();
        }
      })();
    </script>

    {/* 覆盖层清理器：移除第三方脚本误挂到 <html> 下的全屏覆盖元素 */}
    <script is:inline>
      (function () {
        function cleanupOverlays() {
          var children = Array.prototype.slice.call(document.documentElement.children);
          for (var i = 0; i < children.length; i++) {
            var el = children[i];
            if (el.tagName === "HEAD" || el.tagName === "BODY") continue;
            try {
              var s = window.getComputedStyle(el);
              var z = parseInt(s.zIndex, 10);
              if (
                s.position === "fixed" &&
                s.pointerEvents !== "none" &&
                s.display !== "none" &&
                s.visibility !== "hidden" &&
                !isNaN(z) && z > 1000 &&
                (s.top === "0px" || s.inset === "0px")
              ) {
                console.warn("[cleanup] removed suspicious overlay", el.tagName, el.className, s.zIndex);
                el.remove();
              }
            } catch (e) {}
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", cleanupOverlays, { once: true });
        } else {
          cleanupOverlays();
        }
        setTimeout(cleanupOverlays, 1000);
        setTimeout(cleanupOverlays, 3000);
      })();
    </script>

  </body>
</html>
