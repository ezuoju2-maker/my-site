---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/RegisterForm";
---

<Layout title="注册">
  <main class="min-h-screen bg-white px-5 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto w-full max-w-md">
      <header class="text-center">
        <a href="/my-site/" class="inline-block">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-neutral-200 bg-white text-sm font-semibold tracking-wide text-neutral-700">
            LOGO
          </div>
        </a>

        <h1 class="mt-5 text-xl font-semibold tracking-tight text-neutral-900">
          网站名称
        </h1>

        <h2 class="mt-8 text-2xl font-semibold tracking-tight text-neutral-900">
          创建账户
        </h2>

        <p class="mt-2 text-sm text-neutral-500">
          注册一个新账户
        </p>
      </header>

      <div class="mt-9">
        <RegisterForm client:load />
      </div>
    </div>
  </main>
</Layout>
