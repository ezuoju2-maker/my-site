---
import Layout from "../layouts/Layout.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import AutoLoginRedirect from "../components/AutoLoginRedirect";
import LoginBrand from "../components/LoginBrand";
import AuthTabs from "../components/AuthTabs";

const isGitHubPages = import.meta.env.GITHUB_PAGES === "true";
const MAIN_SITE_URL = "https://q8top.cc.cd/";
---

{isGitHubPages && (
  <Layout title="my-site · 静态灾备站">
    <main class="min-h-screen bg-neutral-50 px-5 py-12">
      <div class="mx-auto w-full max-w-lg space-y-4">
        <header class="text-center">
          <img src="/q8-logo.png" alt="Q8" class="mx-auto mb-5 h-16 w-16 object-contain" style="mix-blend-mode:multiply" />
          <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">my-site</h1>
          <p class="mt-2 text-sm text-neutral-500">静态灾备站 · 主站不可用时的备用入口</p>
        </header>

        <section class="rounded-2xl border border-neutral-100 bg-white p-5">
          <h2 class="text-base font-semibold text-neutral-900">前 往主站</h2>
          <a href={MAIN_SITE_URL} class="mt-4 flex h-12 w-full items-center justify-center rounded-lg bg-neutral-900 px-4 text-base font-medium text-white">
            打开主站
          </a>
        </section>
      </div>
    </main>
  </Layout>
)}

{!isGitHubPages && (
  <Layout title="欢迎">
    <LoadingScreen />
    <AutoLoginRedirect client:load />
    <section class="flex min-h-screen items-center justify-center px-5 py-4 sm:px-6">
      <div class="w-full max-w-md">
        <LoginBrand client:load />
        <AuthTabs client:load initialTab="login" />
      </div>
    </section>
  </Layout>
)}
