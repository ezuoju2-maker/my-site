---
import Layout from "../layouts/Layout.astro";
import AutoLoginRedirect from "../components/AutoLoginRedirect";
import LoginForm from "../components/LoginForm";
import LoginBrand from "../components/LoginBrand";

const isGitHubPages = import.meta.env.GITHUB_PAGES === "true";
const MAIN_SITE_URL = "https://my-site-n7j.pages.dev/";
---

{isGitHubPages && (
  <Layout title="my-site · 静态灾备站">
    <main class="min-h-screen bg-neutral-50 px-5 py-12">
      <div class="mx-auto w-full max-w-lg space-y-4">
        {/* 头部 */}
        <header class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl border border-neutral-200 bg-white text-sm font-semibold tracking-wide text-neutral-700">
            LOGO
          </div>
          <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">
            my-site
          </h1>
          <p class="mt-2 text-sm text-neutral-500">
            静态灾备站 · 主站不可用时的备用入口
          </p>
        </header>

        {/* 状态卡 */}
        <section class="rounded-2xl border border-neutral-100 bg-white p-5">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-neutral-300" />
            <span class="text-sm font-medium text-neutral-700">服务状态</span>
          </div>
          <p class="mt-2 text-sm text-neutral-500">
            此页面为静态副本，不提供登录、注册、数据查询等功能。
          </p>
        </section>

        {/* 主站入口 */}
        <section class="rounded-2xl border border-neutral-100 bg-white p-5">
          <h2 class="text-base font-semibold text-neutral-900">前往主站</h2>
          <p class="mt-2 text-sm text-neutral-500">
            注册、登录、密码重置、用户中心等完整功能：
          </p>
          <a
            href={MAIN_SITE_URL}
            class="mt-4 flex h-12 w-full items-center justify-center rounded-lg bg-neutral-900 px-4 text-base font-medium text-white"
          >
            打开主站
          </a>
          <p class="mt-3 break-all text-xs text-neutral-400">
            {MAIN_SITE_URL}
          </p>
        </section>

        {/* 说明 */}
        <section class="rounded-2xl border border-neutral-100 bg-white p-5">
          <h2 class="text-base font-semibold text-neutral-900">关于本站</h2>
          <ul class="mt-3 space-y-2 text-sm text-neutral-600">
            <li class="flex gap-2">
              <span class="text-neutral-400">•</span>
              <span>主站不可用时，本页仍可访问</span>
            </li>
            <li class="flex gap-2">
              <span class="text-neutral-400">•</span>
              <span>账号数据全部在主站，本站不存储任何用户信息</span>
            </li>
            <li class="flex gap-2">
              <span class="text-neutral-400">•</span>
              <span>如需登录或修改密码，请访问主站</span>
            </li>
          </ul>
        </section>

        {/* 页脚 */}
        <footer class="pt-2 text-center text-xs text-neutral-400">
          <p>Static disaster recovery mirror</p>
        </footer>
      </div>
    </main>
  </Layout>
)}

{!isGitHubPages && (
  <Layout title="登录">
    <AutoLoginRedirect client:load />
    <section class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-6">
      <div class="w-full max-w-md">
        <LoginBrand client:load />
        <LoginForm client:load />
      </div>
    </section>
  </Layout>
)}
