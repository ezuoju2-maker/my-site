---
import Layout from "../layouts/Layout.astro";
import RegisterBrand from "../components/RegisterBrand";
import ForgotPasswordForm from "../components/ForgotPasswordForm";
---

<Layout title="忘记密码">
  <main class="min-h-screen bg-white px-5 py-6 sm:px-6 sm:py-8">
    <div class="mx-auto w-full max-w-md">
      <RegisterBrand client:load />
      <div class="mt-6">
        <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <div class="flex items-center gap-2 border-b border-neutral-100 px-3 py-3">
            <button
              type="button"
              onclick="if (history.length > 1) history.back(); else window.location.href = '/';"
              class="flex h-8 w-8 items-center justify-center rounded-lg text-neutral-600 transition-colors hover:bg-neutral-100"
              aria-label="返回登录"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
              </svg>
            </button>
            <h2 class="text-sm font-medium text-neutral-900">忘记密码</h2>
          </div>

          <div class="p-5">
            <p class="mb-4 text-xs text-neutral-500">
              通过注册邮箱验证后设置新密码
            </p>
            <ForgotPasswordForm client:load />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
